diff --git a/lib/leaderboard/banned_words.dart b/lib/leaderboard/banned_words.dart
new file mode 100644
index 0000000..10995a3
--- /dev/null
+++ b/lib/leaderboard/banned_words.dart
@@ -0,0 +1,98 @@
+/// Nickname screening for the shared leaderboard.
+///
+/// This is the friendly half of the job: it tells a player straight away that
+/// a name will not be accepted, instead of letting them submit and watch it
+/// fail. It is **not** the control. The publishable key is compiled into the
+/// public JavaScript bundle, so anyone can post to the REST endpoint without
+/// going near this code. The enforcement is a Postgres trigger on
+/// `torque_chase_scores`; see `supabase/name_filter.sql`, which uses the same
+/// two lists and the same folding.
+///
+/// Two lists, because one is not enough:
+///
+/// * [bannedAnywhere] is for words long and specific enough that finding them
+///   inside a longer string is almost certainly deliberate.
+/// * [bannedAsWholeWord] is for the short ones. Matching those as substrings
+///   rejects Cassandra, Essex, Weedon and Scunthorpe, which on a public stand
+///   is a worse failure than the thing it prevents.
+library;
+
+/// Rejected wherever they appear, after folding.
+const List<String> bannedAnywhere = <String>[
+  // sexual and scatological
+  'fuck', 'fuk', 'shit', 'cunt', 'asshole', 'bastard', 'bitch', 'whore',
+  'slut', 'wank', 'jerkoff', 'blowjob', 'handjob', 'semen', 'penis',
+  'vagina', 'pussy', 'boobs', 'porn', 'horny', 'rapist', 'masturbat',
+  // slurs
+  'nigger', 'nigga', 'niger', 'kaffir', 'kaffer', 'coolie', 'wetback',
+  'faggot', 'fagot', 'tranny', 'shemale', 'retard', 'spastic', 'mongoloid',
+  'hottentot', 'boesman', 'kwerekwere', 'hymie', 'pikey',
+  // hate and violence
+  'hitler', 'nazi', 'genocide', 'terrorist', 'jihad', 'lynch', 'suicide',
+  'selfharm', 'killyou',
+  // drugs
+  'cocaine', 'heroin', 'nyaope',
+  // impersonating the stand
+  'administrator', 'moderator', 'lecturer', 'professor', 'supervisor',
+  'examiner',
+];
+
+/// Rejected only when they are the whole of one word in the name. Short, or
+/// common inside ordinary words and names.
+const List<String> bannedAsWholeWord = <String>[
+  'ass', 'arse', 'crap', 'piss', 'twat', 'dick', 'cock', 'tits', 'fag',
+  'cum', 'sex', 'rape', 'nude', 'naked', 'dyke', 'spaz', 'kike', 'spic',
+  'gook', 'chink', 'paki', 'yid', 'gypo', 'honky', 'kkk', 'isis', 'fck',
+  'poes', 'doos', 'kak', 'fok', 'naai', 'piel', 'moer', 'kffr',
+  'meth', 'tik', 'weed', 'murder', 'admin', 'staff', 'official', 'wits',
+];
+
+/// Leetspeak and punctuation dodges, folded before matching. The identical
+/// mapping is applied by `normalise_nickname()` in Postgres.
+const Map<String, String> _foldings = <String, String>{
+  '4': 'a', '@': 'a',
+  '0': 'o', '(': 'c',
+  '1': 'i', '!': 'i', '|': 'i',
+  '3': 'e',
+  '8': 'b',
+  '\$': 's', '5': 's',
+  '7': 't', '+': 't',
+};
+
+String _fold(String value) {
+  var folded = value.toLowerCase();
+  _foldings.forEach((from, to) => folded = folded.replaceAll(from, to));
+  return folded;
+}
+
+/// Every letter of the name, run together. `F.U.C.K` and `f u c k` both
+/// collapse to `fuck`, which is what catches a word split up to sneak past.
+String normaliseNickname(String value) =>
+    _fold(value).replaceAll(RegExp(r'[^a-z]'), '');
+
+/// The name as separate words, each reduced to its letters. Used for the
+/// short words, so `ass` is caught but `Cassandra` is not.
+List<String> nicknameTokens(String value) => _fold(value)
+    .replaceAll(RegExp(r'[^a-z]+'), ' ')
+    .trim()
+    .split(' ')
+    .where((token) => token.isNotEmpty)
+    .toList();
+
+/// True when the nickname contains something that should not go on a screen
+/// in a public hall.
+bool containsBannedWord(String value) {
+  final folded = normaliseNickname(value);
+  if (folded.isEmpty) return false;          // handled separately: no letters
+  for (final word in bannedAnywhere) {
+    if (folded.contains(word)) return true;
+  }
+  final tokens = nicknameTokens(value);
+  for (final word in bannedAsWholeWord) {
+    if (tokens.contains(word)) return true;
+    // A name with no spaces at all is one token, so a short word typed on its
+    // own still has to be caught: "sh1t" folds to a single token "shit".
+    if (tokens.length == 1 && folded == word) return true;
+  }
+  return false;
+}
